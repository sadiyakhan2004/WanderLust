<%layout("/layouts/boilerplate.ejs")%>

  <body>

    <div class="row  mt-3">
      <div class="col-8 offset-2 mb-0 ">
        <h3>
          <%=listing.title%>
        </h3>
      </div>

      <div class="col-8 offset-2 mt-0">

        <div class="card show-card listing-card">
          <img src="<%=listing.image.url %>" class="card-img-top show-img" alt="Listing_image">
          <div class="card-body">
            <p class="card-text"><i>Owned by <%= listing.owner.username%></i></p>
            <p class="card-text">
              <%= listing.description %>
            </p>
            <p class="card-text">&#8377; <%= listing.price.toLocaleString("EN-IN") %>
            </p>
            <p class="card-text">
              <%= listing.location %>
            </p>
            <p class="card-text">
              <%=
                listing.country.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' '); %>
            </p>
          </div>

        <% if (!currUser || !(currUser._id.equals(listing.owner._id))) { %>
         <div class="card reservation-card shadow mt-4 mb-4 col-12 col-md-12 col-lg-6">
           <div class="card-header">
              <h5> &#8377; <%= listing.price.toLocaleString("EN-IN") %> <span style="opacity: 0.75; font-size: medium;">night</span></h5>
            </div>
            <form action="/listings/<%=listing._id%>/reserveListing" method="GET">
              <div class="row ">
                <div class="mb-3 col-md-6">
                  CHECK-IN
                  <input type="date" min="" class="form-control checkIn" name="checkInDate" oninput="getNumOfDays()" required>
                </div>
                <div class="mb-3  col-md-6">
                  CHECK-OUT
                  <input type="date" min="2024-09-08" name="checkOutDate" class="form-control checkOut" oninput="getNumOfDays()" required>
                </div>
              </div>
              <div class="guests form-control mb-2 col-6">
                <div class="guest-count">
                   <p style="font-size: 0.8rem;">GUEST</p>
                   <p id="count-display"><span class="count-display"></span> guest <span class="infantsCount" style="display: none;"></span></p>
                </div>
                <div class="guest-icon" >
                  <i class="fa-solid fa-angle-down"></i>
                </div>
              </div>
               <div class="mb-4 guestInfo " style="display:none;">
                  <div class="mb-3 col-md-6">
                    Adult (Age 13+)
                    <input min="1" type="number" name="adultCount" class="form-control adult" required>  
                  </div>
                  <div class="mb-3 col-md-6">
                    Children (Age 2-12)
                    <input min="0" type="number" name="childrenCount" class="form-control children" >
                    <p style="font-size: smaller;">Atleast 1 adult shoud be there</p>
                  </div>
                  <div class="mb-3 col-md-6">
                    Infants (Under 2)
                    <input min="0" max="4" type="number" name="infantsCount" class="form-control infants">
                    <p style="font-size: smaller;">Atleast 1 adult shoud be there</p>
                  </div>
               </div>
               <button class=" btn btn-danger d-grid gap-2 col-6 mx-auto">Reserve</button>

            <div style="display: none;" id="result-div" >
               <h6 class="result-h mt-3" >You won't be charged yet</h6>
               <div class="result-div">
                <p class="result-p">&#8377; <%= listing.price.toLocaleString("EN-IN") %>x <span id="totalNights"></span> </p>
                <p class="result result-p"></p>
                <p class="price" style="display: none;"><%=listing.price %></p>
               </div>
               </div>
            </form>
          </div>
         <% } %>

      </div>

        <% if ( currUser && currUser._id.equals(listing.owner._id)) { %>
          <div class="btns mt-3 mb-3 col-9">
            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn col-5 col-md-3 col-lg-2">
              Edit</a>

            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
              <button class="btn btn-dark offset-4">Delete</button>
            </form>
          </div>
          <% } %>


            <div class="col-12 ">
              </hr>
              <% if(currUser) { %>
                <hr>

                <h4>Leave a Review</h4>

                <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">

                  <div class="mt-3 mb-3 ">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                      <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                        aria-label="No rating." />
                      <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                      <label for="first-rate1" title="Terrible">1 star</label>
                      <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                      <label for="first-rate2" title="Not good">2 stars</label>
                      <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                      <label for="first-rate3" title="Average">3 stars</label>
                      <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                      <label for="first-rate4" title="Very good">4 stars</label>
                      <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                      <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                  </div>

                  <div class="mt-3 mb-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control"
                      required></textarea>
                    <div class="invalid-feedback">Please add some comment for review</div>
                  </div>

                  <button class="btn btn-outline-dark">Submit</button>
                </form>
                <% } %>
                  <hr>
                  <% if (listing.reviews.length){ %>
                    <p><b>All Reviews</b></p>
                    <% } %>
                      <div class="row ">
                        <% for( review of listing.reviews){%>
                          <div class="card col-12 col-md-5 col-lg-5 mb-3 ms-3 ">
                            <div class="card-body">
                              <h5 class="card-title">@<%=review.author.username%>
                              </h5>
                              <p class="starability-result" data-rating=<%=review.rating %>></p>
                              <p class="card-text mb-2">
                                <%=review.comment %>
                              </p>
                            
                              <% if(currUser && currUser._id.equals(review.author._id)){ %>
                              <form class="mb-3" method="POST"
                                action="/listings/<%= listing._id %>/reviews/<%=review._id%>?_method=DELETE">
                                <button class="btn btn-sm btn-dark">Delete</button>
                              </form>
                              <% } %>
                            </div>
                          </div>
                          <% } %>
                      </div>
            </div>
      </div>
    </div>

    <script src="/js/show.js"></script>
  </body>