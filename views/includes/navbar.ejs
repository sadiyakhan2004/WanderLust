<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
    display: flex;
    align-items: center;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .search-btn i {
    margin-right: 0.5rem;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 4rem 0.5rem 4rem;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
        <form class="d-flex " role="search" action="/listings/search" method="GET">
          <input class="form-control me-2 search-inp" type="search" placeholder="Search Country.." aria-label="Search"
            name="country">
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        </form>
      </div>

      <div class="navbar-nav ms-auto">

        <a class="nav-link" href="/listings/new">Airbnb your home</a>

        <div class="btn-group  dropstart">
          <a class=" nav-link " data-bs-toggle="dropdown" aria-expanded="true" data-bs-offset="30,50">
            <i class="fa-solid fa-circle-user"></i>
          </a>
          <ul class="dropdown-menu ">

            <% if (currUser) { %>
              <li><a class="dropdown-item" href="#"> <b>@<%= currUser.username %></b></a></li>
              <li><a class="dropdown-item" href="#"><i>
                    <%= currUser.email %>
                  </i></a></li>
              <li>
                <hr class="dropdown-divider">
              </li>
              <% } %>

                <% if (currUserListings.length) { %>
                  <h6>Listings you've created :</h6>
                  <ul>
                    <% for( let listing of currUserListings){ %>
                      <li style="font-size: 0.85rem;"><i><a class="dropdown-item" href="/listings/<%=listing._id%>">
                            <%=listing.title%></i></a></li>
                      <%} %>
                  </ul>
                  <li>
                    <hr class="dropdown-divider">
                  </li>
                  <% } %>


                    <% if (!currUser) { %>
                      <li><a class="nav-link" href="/signup"><b><i>SignUp</i></b></a></li>
                      <li><a class="nav-link" href="/login"><b><i>Login</i></b></a></li>
                      <% } %>
                        <% if (currUser) { %>
                          <li><a class="nav-link" href="/logout">&nbsp;<b>&nbsp;&nbsp;<i
                                  class="fa-solid fa-arrow-right-from-bracket"></i> Logout</b></a></li>
                          <% } %>
                            <li>
                              <hr class="dropdown-divider">
                            </li>

          </ul>
        </div>



      </div>
    </div>
  </div>
</nav>